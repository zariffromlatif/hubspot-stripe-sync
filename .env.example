# HubSpot private app access token (scopes: crm.objects.contacts.read/write, crm.schemas.contacts.write)
HUBSPOT_TOKEN=
# HubSpot app client secret (used to verify X-HubSpot-Signature-v3 on webhooks)
HUBSPOT_CLIENT_SECRET=
# Stripe secret key (use a restricted key: Customers read/write)
STRIPE_API_KEY=
# Stripe webhook endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# The public URL HubSpot/Stripe call, e.g. https://sync.yourclient.com (no trailing slash)
PUBLIC_BASE_URL=
# Bearer token for the /dead-letters admin endpoints
ADMIN_TOKEN=
# Optional
SLACK_WEBHOOK_URL=
DB_PATH=sync.db
ECHO_WINDOW_SECONDS=120
